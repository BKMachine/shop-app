FROM node:24 AS base
WORKDIR /app
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV pnpm_config_store_dir="/pnpm/store"
ENV PATH="${PATH}:${PNPM_HOME}/bin"
RUN npm install -g pnpm@11.23.0 turbo@2.10.8

FROM base AS source
COPY . .

FROM source AS haas_serial-prune
RUN turbo prune haas_serial --docker

FROM base AS haas_serial-installer
COPY --from=haas_serial-prune /app/out/json/ .
RUN grep -q '^  injectWorkspacePackages: true$' pnpm-lock.yaml || sed -i "/^settings:$/a\\  injectWorkspacePackages: true" pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --config.inject-workspace-packages=true
COPY --from=haas_serial-prune /app/out/full/ .

FROM haas_serial-installer AS haas_serial-builder
COPY biome.json biome.json
ENV pnpm_config_verify_deps_before_run=false
RUN pnpm run ci --filter=haas_serial
RUN pnpm run build --filter=haas_serial

FROM haas_serial-installer AS haas_serial-deploy
ENV pnpm_config_verify_deps_before_run=false
RUN pnpm run build --filter=@repo/utilities
RUN pnpm deploy --filter=haas_serial --prod --config.inject-workspace-packages=true /app/deploy/haas_serial

FROM node:22-slim AS runner
WORKDIR /app
COPY --from=haas_serial-deploy /app/deploy/haas_serial/node_modules /app/apps/haas_serial/node_modules  
COPY --from=haas_serial-builder /app/apps/haas_serial/dist /app/apps/haas_serial/dist
ENV NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=10s \
  CMD node -e "require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
CMD ["node", "/app/apps/haas_serial/dist/index.js"]
