FROM node:24 AS base
WORKDIR /app
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV pnpm_config_store_dir="/pnpm/store"
ENV PATH="${PATH}:${PNPM_HOME}/bin"
RUN npm install -g pnpm@12.11.2 turbo@2.11.8

FROM base AS source
COPY . .

FROM source AS status-prune
RUN turbo prune status --docker

FROM base AS status-installer
COPY --from=status-prune /app/out/json/ .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile
COPY --from=status-prune /app/out/full/ .

FROM status-installer AS status-builder
COPY biome.json biome.json
ENV pnpm_config_verify_deps_before_run=false 
RUN pnpm run ci --filter=status
RUN pnpm run build --filter=status

FROM status-installer AS status-deploy
ENV pnpm_config_verify_deps_before_run=false
RUN pnpm run build --filter=@repo/utilities
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm deploy --filter=status --prod /app/deploy/status

# Same Node major as the build stages, so production runs what CI tested.
FROM node:24-slim AS runner
WORKDIR /app
COPY --from=status-deploy /app/deploy/status/node_modules /app/apps/status/node_modules
# package.json carries "type": "module"; without it Node only runs dist as ESM by sniffing syntax.
COPY --from=status-deploy /app/deploy/status/package.json /app/apps/status/package.json
COPY --from=status-builder /app/apps/status/dist /app/apps/status/dist
ENV NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=10s \
  CMD node -e "require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
CMD ["node", "/app/apps/status/dist/index.js"]
