{
  "name": "haas_serial",
  "type": "module",
  "version": "1.0.0",
  "description": "Haas Serial Post status gatherer for the Shop App",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false -r dotenv/config ./src/index.ts",
    "build": "rimraf ./dist && tsc",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check",
    "ci": "biome ci",
    "check-types": "tsc --noEmit",
    "test": "jest"
  },
  "engineStrict": true,
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@repo/utilities": "workspace:*",
    "hono": "^4.13.13",
    "http-terminator": "^3.2.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/shop-app": "workspace:*",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
