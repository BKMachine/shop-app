{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "description": "Server for the Shop App",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false -r dotenv/config ./src/index.ts",
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "ci": "biome ci",
    "check-types": "tsc --noEmit",
    "repair:images": "tsx -r dotenv/config ./scripts/repair_image_database.ts",
    "export:parts-material-cycle-csv": "tsx -r dotenv/config ./scripts/export_part_material_cycle_csv.ts",
    "report:stale_tools": "tsx -r dotenv/config ./scripts/report_stale_tools.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./jest.config.cjs",
    "fixture:pdf-text": "tsx ./scripts/pdf_fixture_text_pdf.ts",
    "database:derived": "tsx -r dotenv/config ./scripts/add_derived_properties.ts",
    "mongodump": "tsx -r dotenv/config ./scripts/mongodump.ts",
    "mount:data": "bash ./scripts/mount_data_nfs.sh"
  },
  "dependencies": {
    "@repo/utilities": "workspace:*",
    "axios": "^1.20.0",
    "bwip-js": "^4.11.4",
    "cron": "^4.4.0",
    "express": "^5.3.0",
    "http-terminator": "^3.2.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/shop-app": "workspace:*",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
