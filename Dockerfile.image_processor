FROM node:24 AS base
WORKDIR /app
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV pnpm_config_store_dir="/pnpm/store"
ENV PATH="${PATH}:${PNPM_HOME}/bin"
RUN npm install -g pnpm@11.23.0 turbo@2.10.8

FROM base AS source
COPY . .

FROM source AS image-processor-prune
RUN turbo prune image_processor --docker

FROM base AS image-processor-installer
COPY --from=image-processor-prune /app/out/json/ .
RUN grep -q '^  injectWorkspacePackages: true$' pnpm-lock.yaml || sed -i "/^settings:$/a\\  injectWorkspacePackages: true" pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --config.inject-workspace-packages=true
COPY --from=image-processor-prune /app/out/full/ .

FROM image-processor-installer AS image-processor-builder
ENV pnpm_config_verify_deps_before_run=false
COPY biome.json biome.json
RUN pnpm run ci --filter=image_processor
RUN pnpm run build --filter=image_processor

FROM image-processor-installer AS image-processor-deploy
ENV pnpm_config_verify_deps_before_run=false
RUN pnpm run build --filter=@repo/utilities
RUN pnpm deploy --filter=image_processor --prod --config.inject-workspace-packages=true /app/deploy/image_processor

FROM node:22-slim AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
  libgl1 \
  libglib2.0-0 \
  libgomp1 \
  python3 \
  python3-venv \
  && rm -rf /var/lib/apt/lists/*
COPY --from=image-processor-deploy /app/deploy/image_processor/node_modules /app/apps/image_processor/node_modules
COPY --from=image-processor-builder /app/apps/image_processor/dist /app/apps/image_processor/dist
COPY --from=image-processor-builder /app/apps/image_processor/assets /app/apps/image_processor/assets
COPY --from=image-processor-builder /app/apps/image_processor/scripts /app/apps/image_processor/scripts
ENV IMAGE_PROCESSOR_VENVS_DIR=/app/apps/image_processor/.venv
ENV REMBG_VENV_DIR=/app/apps/image_processor/.venv/.venv-rembg
ENV OCR_VENV_DIR=/app/apps/image_processor/.venv/.venv-ocr
ENV XDG_CACHE_HOME=/app/data/cache
ENV HF_HOME=/app/data/cache/huggingface
ENV PADDLE_HOME=/app/data/cache/paddle
ENV NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=10s \
  CMD node -e "require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
ENTRYPOINT ["bash", "/app/apps/image_processor/scripts/bootstrap_image_processor.sh"]
CMD ["node", "/app/apps/image_processor/dist/index.js"]
