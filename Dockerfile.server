# syntax=docker/dockerfile:1.7

FROM node:22 AS base
WORKDIR /app
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}/bin"
ENV npm_config_store_dir="/pnpm/store"
RUN npm install -g pnpm@11.18.0 turbo@2.10.8

# Full source tree. Only feeds the prune stages below, so it never reaches an
# app stage directly. The downloads payload is stripped here: it is a ~47MB
# prebuilt binary served statically at runtime, and nothing builds or tests
# against it, so it must not sit inside a prune output and invalidate a build.
# The final image copies it straight from the build context instead.
FROM base AS source
COPY . .
RUN rm -rf apps/server/public/downloads

# SERVER

FROM source AS server-prune
RUN turbo prune server --docker

FROM base AS server-installer
COPY --from=server-prune /app/out/json/ .
RUN grep -q '^  injectWorkspacePackages: true$' pnpm-lock.yaml || sed -i "/^settings:$/a\\  injectWorkspacePackages: true" pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --config.inject-workspace-packages=true
COPY --from=server-prune /app/out/full/ .

FROM server-installer AS server-builder
COPY biome.json biome.json
RUN pnpm run ci --filter=server
RUN pnpm run test --filter=server
RUN pnpm run build --filter=server

FROM server-installer AS server-deploy
RUN pnpm run build --filter=@repo/utilities
RUN pnpm deploy --filter=server --prod --config.inject-workspace-packages=true /app/deploy/server

# WWW

FROM source AS www-prune
RUN turbo prune www --docker

FROM base AS www-installer
COPY --from=www-prune /app/out/json/ .
RUN grep -q '^  injectWorkspacePackages: true$' pnpm-lock.yaml || sed -i "/^settings:$/a\\  injectWorkspacePackages: true" pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --config.inject-workspace-packages=true
COPY --from=www-prune /app/out/full/ .

FROM www-installer AS www-builder
COPY biome.json biome.json
RUN pnpm run ci --filter=www
RUN pnpm run build --filter=www

# FINAL IMAGE

FROM node:22-slim AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends cups-client && rm -rf /var/lib/apt/lists/*
COPY apps/server/public/downloads /app/apps/server/public/downloads
COPY --from=server-deploy /app/deploy/server/node_modules /app/apps/server/node_modules
COPY --from=server-builder /app/apps/server/dist /app/apps/server/dist
COPY --from=www-builder /app/apps/www/dist /app/apps/www/dist
ENV NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=10s \
  CMD node -e "require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
CMD ["node", "/app/apps/server/dist/index.js"]
